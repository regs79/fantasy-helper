# Copy to .env (gitignored).

# Yahoo app credentials from https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Optional: your league id (the number in the Yahoo league URL).
YAHOO_LEAGUE_ID=

# Local server
PORT=3000
HOST=127.0.0.1
# DATA_DIR=./data

# Release (scripts/release.sh): the plain-HTTP registry on your LAN, host:port.
REGISTRY=192.168.1.10:5000
IMAGE=fantasy-helper

# Deploy (read by compose.yml on the server). TAG is the SHA release.sh printed.
TAG=
HOST_PORT=3010

# Mac side: when set, release.sh SSHes in after the push, updates TAG in the
# remote .env and runs docker compose up -d. DEPLOY_SSH is an ssh host alias;
# DEPLOY_DIR must be absolute (no ~).
DEPLOY_SSH=myserver
DEPLOY_DIR=/home/me/docker/apps/fantasy-helper
